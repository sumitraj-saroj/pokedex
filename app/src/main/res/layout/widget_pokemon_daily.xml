<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_daily_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_surface_bg"
    android:padding="12dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_widget_pokeball"
            android:contentDescription="Pokéball" />

        <TextView
            android:id="@+id/widget_daily_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="POKÉMON OF THE DAY"
            android:textColor="@color/widget_text_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/widget_daily_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_widget_refresh"
            android:scaleType="centerInside"
            android:contentDescription="Refresh Pokémon" />
    </LinearLayout>

    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Artwork Container -->
        <FrameLayout
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:background="@drawable/widget_image_container_bg"
            android:padding="6dp">

            <ImageView
                android:id="@+id/widget_pokemon_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Pokémon Artwork" />
        </FrameLayout>

        <!-- Information Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_pokemon_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#0025 Pikachu"
                android:textColor="@color/widget_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/widget_pokemon_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_chip_bg"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="ELECTRIC"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_pokemon_gen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="Gen 1 • Kanto"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_pokemon_flavor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="When several of these Pokémon gather, their electricity could build and cause lightning storms."
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
